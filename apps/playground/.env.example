# Credentials for the `/app` live tutor route.
# Copy this file to `.env.local` (git-ignored) and fill in the key.
# The values can be copied from the platform's LLM configuration.

DAHL_BASE_URL=https://inference.dahl.global/v1
DAHL_API_KEY=
# Comma-separated allowlist; the first entry is the default model.
DAHL_MODELS=MiniMaxAI/MiniMax-M2.7,deepseek-ai/DeepSeek-V4-Flash-0731,zai-org/GLM-5.3-Flash
DAHL_MAX_TOKENS=4096
DAHL_TIMEOUT=120
