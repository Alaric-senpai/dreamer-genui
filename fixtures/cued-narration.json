          "type": "steps",
          "reveal": "sequential",
          "items": [
            { "id": "osm-step-1", "title": "Membrane", "content": ["Water molecules gather at the membrane."], "enter": { "effect": "wipe", "trigger": { "on": "cue", "id": "beat-3" } } },
            { "id": "osm-step-2", "title": "Flow", "content": ["Water flows toward the higher solute concentration."], "enter": { "effect": "wipe", "trigger": { "on": "cue", "id": "beat-3" }, "order": 2 } },
            { "id": "osm-step-3", "title": "Balance", "content": ["Flow slows as concentrations equalise."], "enter": { "effect": "wipe", "trigger": { "on": "after", "node": "osm-step-2" } } }
          ],
          "enter": { "effect": "stagger", "order": 3 }
        },
