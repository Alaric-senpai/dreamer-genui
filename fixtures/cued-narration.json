            { "id": "toward-solvent", "label": "Lower solute concentration", "ref": "osm-factors/solvent", "icon": "arrow-down" },
            { "id": "neither", "label": "Neither — it is random", "ref": "osm-factors/random", "icon": "shuffle" }
          ],
          "enter": { "effect": "pop", "trigger": { "on": "cue", "id": "beat-4" }, "order": 4 }
        }
